# Bring your own keys — nothing here is committed. Copy to .env.local and fill in.

# ============================================================================
# App mode — who pays for Valyu retrieval
# ============================================================================
# "self-hosted" (default) — the deployment's own VALYU_API_KEY pays for every
#                           review; nobody signs in.
# "valyu"                 — each reviewer signs in with their Valyu account over
#                           OAuth and reviews run on THEIR credits. VALYU_API_KEY
#                           is not needed; the OAuth block below is.
# Anything other than "valyu" is treated as self-hosted.
NEXT_PUBLIC_APP_MODE=self-hosted

# Valyu — the evidence backend (https://platform.valyu.ai)
# Required for self-hosted mode. Unused in valyu mode.
VALYU_API_KEY=

# ============================================================================
# OAuth — required for valyu mode only (leave blank for self-hosted)
# ============================================================================
# Register an OAuth app on the Valyu platform to get the client id/secret.

# Client id — public, sent from the browser to start the PKCE flow.
NEXT_PUBLIC_VALYU_CLIENT_ID=

# Client secret — SERVER ONLY. Never prefix this NEXT_PUBLIC_ or it ships to
# the browser. Used only by the /api/oauth token + refresh routes.
VALYU_CLIENT_SECRET=

# Valyu OAuth authorization server.
NEXT_PUBLIC_VALYU_AUTH_URL=https://auth.valyu.ai

# Valyu platform origin — userinfo lookup and the credit-billing OAuth proxy.
VALYU_APP_URL=https://platform.valyu.ai

# OAuth redirect target — must exactly match the callback registered on the
# Valyu OAuth app. In production swap the origin for your deployed URL.
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/auth/valyu/callback

# OpenAI — claim extraction & entailment (https://platform.openai.com)
OPENAI_API_KEY=
# Model for extraction/entailment (any structured-output-capable model)
OPENAI_MODEL=gpt-5.6-terra

# Postgres — audit trail & review persistence (optional in Phase 0).
# Leave unset to run without persistence; the pipeline still returns full results.
# DATABASE_URL=postgres://openmlr:openmlr@localhost:5432/openmlr
# Reasoning effort: minimal | low | medium | high | off (default low — fast + accurate)
OPENAI_REASONING_EFFORT=low

# DeepResearch completion emails.
# In valyu mode the signed-in reviewer's own address is used automatically — the
# task carries it to Valyu, which sends the email when the report lands. This is
# only for self-hosted mode, where there is no signed-in user to notify. Leave
# unset and nobody is emailed; the in-app toast and title badge still work.
# DR_ALERT_EMAIL=

# Free trial (valyu mode only; needs both VALYU_API_KEY and DATABASE_URL).
# How many reviews an anonymous visitor may run before the sign-up wall, plus
# the two abuse backstops: a per-network daily cap and a global daily budget so
# a spike can't drain the deployment key. Defaults below.
# ANON_FREE_RUNS=1
# ANON_IP_DAILY_CAP=5
# ANON_DAILY_BUDGET=200
#
# Testing the funnel locally: leave these at their defaults and run
# `npm run dev:reset-trial` to clear the meter between passes — that exercises
# the real wall. Raise ANON_FREE_RUNS / ANON_IP_DAILY_CAP instead only when you
# want the wall out of the way while iterating on the review itself.
