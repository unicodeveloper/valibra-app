# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.*
secrets.*

# misc
.DS_Store
*.log
npm-debug.log*

# typescript
*.tsbuildinfo
*.html

# NOTE: a blanket `*.md` used to live here. It silently kept eval/README.md out of
# the repo while readme.md survived only because it predates the rule, leaving a
# broken link from the main README. Ignore scratch markdown by path, not by suffix.

# eval: keep the current scoreboard, not every timestamped run
eval/results/*.json
!eval/results/latest.json
